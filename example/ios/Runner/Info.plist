<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>MapMetrics</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>maplibre_example</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>This app needs your location to display your location on the map.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>This app requires access to your location..</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>This app requires access to your location.</string>
	<!-- Pins the gateway origin for MMMapSession. Without this the SDK has no
	     origin, createIfConfigured is a no-op, and no session is ever opened no
	     matter what apiKey is passed.

	     PRODUCTION, matching the Android example's MapSessionOrigin. This used
	     to point at gateway-mapatlas-staging.jim9710.workers.dev, on the
	     reasoning that example runs should be metered against the staging
	     account rather than a customer's. Two things retired that:

	       1. The examples now load the credential-free demo style, so they
	          pass no apiKey. createIfConfigured needs a cached key, so it is
	          a no-op and NOTHING IS METERED against any account either way --
	          which was the entire benefit of pointing at staging.
	       2. The two platforms disagreed. Android pinned production, iOS
	          pinned staging, so the same example measured different things
	          depending on the device you ran it on, and a customer copying
	          the iOS example got a private staging hostname that will not
	          resolve for them.

	     Staging is deliberately NOT on the SDK's built-in allow-list, so to
	     run against it, replace this value -- pinning is the only way to
	     reach it -- and pass a staging key via --dart-define. See
	     example/lib/staging_session_main.dart. -->
	<key>MLNTileServerBaseURL</key>
	<string>https://gateway.mapmetrics-atlas.net</string>
</dict>
</plist>
